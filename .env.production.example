# =============================================================================
# Contoh konfigurasi produksi — SALIN menjadi .env di server, lalu ganti semua
# nilai CHANGE_ME. Jangan commit file .env atau nilai secret apa pun.
#
# File ini sengaja memakai placeholder yang membuat `app:production-check`
# GAGAL sampai dikonfigurasi dengan benar (APP_URL http, APP_KEY kosong,
# MAIL_FROM_ADDRESS @example.com, kredensial CHANGE_ME).
# =============================================================================

APP_NAME="Sistem Informasi Koperasi Jabar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Wajib HTTPS dan domain resmi. Ganti placeholder ini.
APP_URL=http://CHANGE_ME.invalid
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `daily` membatasi ukuran file dan merotasi otomatis; lihat LOG_DAILY_DAYS.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Idle timeout terautentikasi (menit), terpisah dari lifetime cookie.
SESSION_IDLE_TIMEOUT=30
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Isi hanya IP/CIDR reverse proxy yang benar-benar menangani HTTPS.
# Jangan memakai "*" pada host yang dapat diakses langsung dari internet.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Worker antrean diperlukan bila memakai database. Template systemd tersedia
# di deploy/systemd/koperasi-queue.service.example.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
# null untuk STARTTLS pada port 587; gunakan smtps bila penyedia mewajibkan
# TLS langsung pada port 465. Ikuti instruksi penyedia SMTP dinas.
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="CHANGE_ME@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Header keamanan (NFR-SEC-017). HSTS hanya dikirim pada request HTTPS.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false
# Produksi wajib true setelah aset dan CSP diverifikasi di staging.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_POLICY="default-src 'self'; ..."
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=()"
SECURITY_COOP=same-origin

# F8 (PROVISIONAL). Jangan aktifkan sebelum Q-005 dijawab dan diuji di staging.
ADMIN_REGION_SCOPE_ENABLED=false
# Jumlah baris referensi wilayah yang diharapkan (Q-012).
REGIONS_EXPECTED_TOTAL=6612
# Ambang peringatan izin mendekati kedaluwarsa (hari).
LICENSE_EXPIRING_DAYS=30
# Minimal rapat tahunan untuk checklist kepatuhan (PROVISIONAL).
GOVERNANCE_MIN_MEETINGS=2

VITE_APP_NAME="${APP_NAME}"
