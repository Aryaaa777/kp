[Unit]
Description=Koperasi Jabar — backup database harian + verifikasi restore ke scratch
Documentation=file:/var/www/koperasi/current/docs/BACKUP_RESTORE.md
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=koperasi-backup
Group=koperasi-backup
WorkingDirectory=/var/www/koperasi/current
EnvironmentFile=/etc/koperasi/backup.env
ExecStart=/usr/bin/bash /var/www/koperasi/current/scripts/db-backup-verify.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/koperasi

StandardOutput=journal
StandardError=journal
