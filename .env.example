APP_NAME="Sistem Informasi Koperasi Jabar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koperasi_jabar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Idle timeout terautentikasi (menit). Lihat FR-003.
SESSION_IDLE_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi HTTPS: wajib true. Nilai ini diperiksa oleh app:production-check.
SESSION_SECURE_COOKIE=false

# Reverse proxy/load balancer tepercaya (daftar IP/CIDR dipisah koma).
# Isi hanya bila aplikasi berada di belakang proxy yang menangani HTTPS.
# Jangan gunakan "*" pada host yang dapat diakses langsung.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Header keamanan (NFR-SEC-017). HSTS hanya dikirim pada request HTTPS.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false
# CSP default nonaktif agar Vite HMR lokal tidak terganggu. Produksi wajib true.
SECURITY_CSP_ENABLED=false
SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_POLICY="default-src 'self'; ..."
SECURITY_X_FRAME_OPTIONS=DENY

# F8 (PROVISIONAL). Pembatasan wilayah default nonaktif sampai Q-005 dijawab.
ADMIN_REGION_SCOPE_ENABLED=false
# Jumlah baris referensi wilayah yang diharapkan (Q-012).
REGIONS_EXPECTED_TOTAL=6612
# Ambang peringatan izin mendekati kedaluwarsa (hari).
LICENSE_EXPIRING_DAYS=30
# Minimal rapat tahunan untuk checklist kepatuhan (PROVISIONAL).
GOVERNANCE_MIN_MEETINGS=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
